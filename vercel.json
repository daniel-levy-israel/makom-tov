{
  "headers": [
    {
      "source": "/properties.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/owners",
      "destination": "/owner.html"
    },
    {
      "source": "/owners/photos",
      "destination": "/owner-photos.html"
    },
    {
      "source": "/property/:id",
      "destination": "/index.html"
    }
  ]
}
